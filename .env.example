APP_ENV=development
SECRET_KEY=dev-only-sitneat-change-this-secret
DATABASE_URL=sqlite:///./sitneat.db
ACCESS_TOKEN_EXPIRE_MINUTES=120
FRONTEND_ORIGIN=http://localhost:5173
SEED_DEMO=true

# Vercel project settings for Production and Preview:
